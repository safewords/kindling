/target
/node_modules

# Service settings hold the API token and the app key.
/kindling.toml
/kindling.toml.bak
/.env
/.env.converted

/storage/*.sqlite
/storage/*.sqlite-*
/storage/logs/*
!/storage/logs/.gitkeep

# The built frontend, and the file the dev server writes while it runs.
/public/build
/public/hot

# The boot loaders and images an operator drops in. They are large, they are
# somebody else's binaries, and they are not this repository's to carry.
/tftproot/*
!/tftproot/.gitkeep
!/tftproot/README.md

# Per-developer IDE state.
/.idea
