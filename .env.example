# kindling
#
# Copy to `.env`. Everything here has a default that works on a laptop; the
# two worth setting on a real network are PXE_SERVER_IP and PXE_API_TOKEN.

APP_NAME=kindling
# local | testing | staging | production. Unset means production, which is the
# right default for a deployment — and the reason PXE_SERVER_IP below is
# refused rather than guessed when it is.
APP_ENV=local
APP_DEBUG=false

# --- where machines reach this server --------------------------------------
# The address that goes into every DHCP reply and every generated URL. Detected
# from the routing table when unset, which is right on a machine with one
# interface and a guess on a machine with four. In production, with DHCP on, it
# must be stated.
#PXE_SERVER_IP=10.0.0.2

# Built from PXE_SERVER_IP and SERVER_PORT unless it is set. Behind a reverse
# proxy, or with TLS, say it here.
#PXE_HTTP_BASE=http://boot.example.internal

# What the PXE menu line says on a client's screen.
PXE_DESCRIPTION=kindling netboot

# --- the HTTP listener ------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- policy and files -------------------------------------------------------
# The boot policy — profiles, rules, boot loaders — lives in the database and
# is edited on the Policy screen of the web UI. A TOML policy file from an
# earlier release is imported from this path once, on the first start against
# an empty database, and never read again. Without one, a starter is seeded.
#PXE_RULES_PATH=pxe-rules.toml
# Served over TFTP, and over HTTP under /boot/. Put `undionly.kpxe`,
# `ipxe.efi` and your images here.
PXE_TFTP_ROOT=tftproot
# An IEEE `oui.txt`, or a `prefix,vendor[,class]` CSV, for vendor names beyond
# the built-in table. Optional.
#PXE_OUI_FILE=oui.txt

# --- proxy DHCP -------------------------------------------------------------
# On by default. This server hands out no addresses: it answers the boot half
# of the conversation beside whatever already does DHCP. Turn it off if
# something else is already serving boot options.
PXE_DHCP_ENABLED=true
PXE_DHCP_BIND=0.0.0.0
# Port 4011, the PXE boot server port. Some firmware insists on it.
PXE_DHCP_BOOT_SERVER_PORT=true

# --- TFTP -------------------------------------------------------------------
PXE_TFTP_ENABLED=true
PXE_TFTP_BIND=0.0.0.0
PXE_TFTP_PORT=69
# 1468 is a 1500-byte frame less its headers. Above it every packet fragments.
PXE_TFTP_MAX_BLOCK_SIZE=1468
# RFC 7440 windowing: the difference between a 300MB image over TFTP taking
# two minutes and taking twenty.
PXE_TFTP_MAX_WINDOW_SIZE=16

# --- chainload loop detection -----------------------------------------------
# The backstop for iPXE that announces itself neither by user class (option 77)
# nor by its own options (option 175) — a relay stripped them, or the build
# never set them. Without it such a machine is handed iPXE by iPXE for ever,
# and every individual exchange looks correct.
#
# Counted in whole DHCP transactions, not requests: firmware retransmitting one
# DISCOVER reuses its transaction id, so a lossy network is never mistaken for
# a loop. Below 2 turns the check off.
PXE_LOOP_THRESHOLD=4
PXE_LOOP_WINDOW_SECS=90

# --- the management API -----------------------------------------------------
# Guards everything that changes what a machine will boot. Unset means those
# endpoints are CLOSED, not open. Reading the inventory never needs it.
#   openssl rand -hex 32
#PXE_API_TOKEN=

# --- storage ----------------------------------------------------------------
# SQLite on disk, so the inventory survives a restart. Point DATABASE_URL at
# Postgres or MySQL and nothing else changes.
DB_DATABASE=storage/pxe.sqlite
#DATABASE_URL=postgres://pxe:secret@db.internal/pxe

# How long the boot log is kept. It is the only thing here that grows.
PXE_EVENT_RETENTION_DAYS=30

# --- logging ----------------------------------------------------------------
# auto | json | pretty. `auto` is JSON in production and readable elsewhere.
LOG_FORMAT=auto
